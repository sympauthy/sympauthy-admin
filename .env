VITE_OIDC_CLIENT_ID=admin

# Unset, the panel requests no scope at all and the server applies the admin client's own
# `default-scopes`, which is what keeps this file out of lockstep with the server's configuration.
# Set it to request exactly a list, for a console narrower than its client's defaults.
# VITE_OIDC_SCOPE=openid admin:config:read admin:users:read
